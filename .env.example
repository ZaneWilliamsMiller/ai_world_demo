# 复制本文件为 .env 后填写；.env 已在 .gitignore 中，勿提交密钥。
# Linux / macOS 建议：chmod 600 .env（仅所有者可读，防同机其他用户偷看密钥）

# ═══════════════════════════════════════════════
#  LLM 基础配置（必填）
# ═══════════════════════════════════════════════
# OpenAI 兼容接口（DeepSeek、本地 Ollama 等均可）
LLM_BASE_URL=https://your-llm-api.example.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=your-model-name

# ═══════════════════════════════════════════════
#  连接池配置
# ═══════════════════════════════════════════════
# LLM_POOL_MAX_CONNECTIONS=100
# LLM_POOL_MAX_KEEPALIVE=20
# LLM_POOL_CONNECT_TIMEOUT=10.0
# LLM_POOL_READ_TIMEOUT=120.0

# ═══════════════════════════════════════════════
#  熔断器配置
# ═══════════════════════════════════════════════
# LLM_CIRCUIT_BREAKER=true
# LLM_CB_FAILURE_WINDOW_S=30.0
# LLM_CB_FAILURE_THRESHOLD=3
# LLM_CB_COOLDOWN_S=15.0

# ═══════════════════════════════════════════════
#  响应缓存配置
# ═══════════════════════════════════════════════
# LLM_CACHE_ENABLED=true
# LLM_CACHE_SIZE=128
# LLM_CACHE_TTL_S=300.0

# ═══════════════════════════════════════════════
#  Prompt Cache（OpenAI 兼容）
# ═══════════════════════════════════════════════
# 非 OpenAI API 不支持时设为 false
# LLM_ENABLE_PROMPT_CACHE=false

# ═══════════════════════════════════════════════
#  智能重试配置
# ═══════════════════════════════════════════════
# LLM_MAX_RETRIES=3
# LLM_RETRY_BASE_DELAY_S=1.5
# LLM_MAX_CONCURRENCY=8

# ═══════════════════════════════════════════════
#  自动存档
# ═══════════════════════════════════════════════
# AUTO_SAVE_INTERVAL_S=300.0

# ═══════════════════════════════════════════════
#  服务端口
# ═══════════════════════════════════════════════
# BACKEND_PORT=8765
# FRONTEND_PORT=8766

# ═══════════════════════════════════════════════
#  安全与控制
# ═══════════════════════════════════════════════
# 关闭后端时的认证密钥（留空则无需认证，仅开发环境）
# SHUTDOWN_SECRET=
# 启用测试路由（生产环境务必设为 0）
# ENABLE_TEST_ROUTES=0

# ═══════════════════════════════════════════════
#  CORS 跨域配置
# ═══════════════════════════════════════════════
# * 或留空：任意来源，适合本机调试（不使用跨站 Cookie 凭证）。
# 公网部署请改为逗号分隔的明确来源，例如：
# CORS_ALLOW_ORIGINS=http://127.0.0.1:8765,http://localhost:8765,https://yourdomain.com

# ═══════════════════════════════════════════════
#  可选：本地 Ollama 示例
# ═══════════════════════════════════════════════
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b
