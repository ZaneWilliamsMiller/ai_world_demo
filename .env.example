# 复制本文件为 .env 后填写；.env 已在 .gitignore 中，勿提交密钥。
# Linux / macOS 建议：chmod 600 .env（仅所有者可读，防同机其他用户偷看密钥）
# OpenAI 兼容接口（DeepSeek、本地 Ollama 等均可）

LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-chat

# 单次调用 LLM 超时（秒）
# LLM_TIMEOUT_S=120

# --- 访问控制（CORS）---
# * 或留空：任意来源，适合本机调试（不使用跨站 Cookie 凭证）。
# 公网部署请改为逗号分隔的明确来源，例如：
# CORS_ALLOW_ORIGINS=http://127.0.0.1:8765,http://localhost:8765,https://yourdomain.com

# --- 可选：本地 Ollama 示例 ---
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# --- GitHub 仓库权限（在 github.com 网页操作，勿写进程序）---
# 仓库 → Settings → General → Danger zone：Change repository visibility（公开/私有）
# 仓库 → Settings → Collaborators and teams：添加协作者或团队
# 仓库 → Settings → Actions：是否允许 GitHub Actions、fork 工作流权限
