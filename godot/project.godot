; Engine configuration file.
; Living Paper — Godot Standalone Client
config_version=5

[application]

config/name="活纸 · 江湖行纪 — 独立版"
config/description="AI 驱动的江湖文字冒险 — Godot 独立桌面版"
config/version="0.3.0"
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.3")

[autoload]

GameManager="*res://scripts/game_manager.gd"
ApiClient="*res://scripts/api_client.gd"
GameColors="*res://scripts/game_colors.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

ui_accept.space=false
ui_select.enter=false

[internationalization]

locale/locale_filter_mode=0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="mobile"

[gdscript]

warnings/enable=true
